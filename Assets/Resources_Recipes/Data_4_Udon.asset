  storyText: "\u0E02\u0E49\u0E32\u0E27\u0E40\u0E21\u0E48\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E2B\u0E27\u0E32\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2B\u0E19\u0E36\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E0A\u0E32\u0E27\u0E44\u0E17\u0E22\u0E17\u0E35\u0E48\u0E1B\u0E23\u0E30\u0E01\u0E2D\u0E1A\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E17\u0E33\u0E19\u0E32

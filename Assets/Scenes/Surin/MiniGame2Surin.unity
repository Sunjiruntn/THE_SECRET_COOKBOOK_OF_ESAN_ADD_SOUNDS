  retryVoice: {fileID: 8300000, guid: 5a275fca132c89648b30821950e5689c, type: 3}
  grateSfx: {fileID: 8300000, guid: 33f59ebe51464b348bbc9501beed4d62, type: 3}
  winPanel: {fileID: 1634677255}
  nextLevelButton: {fileID: 1115112377}
  nextSceneName: MiniGame3Surin
  provinceIndex: 2
  statusText: {fileID: 0}
  circularProgressImage: {fileID: 1421350793}
